# 이 파일을 .env로 복사해 사용한다: cp .env.example .env
# 애플리케이션은 .env를 자동으로 읽지 않는다. uv run --env-file .env ... 로 로드한다.

# 데이터베이스 연결 URL (SQLAlchemy 형식). 기본값은 로컬 SQLite 파일이다.
DATABASE_URL=sqlite:///./data/bbs.db

# 다른 데이터베이스 예시 (해당 드라이버, 예: psycopg는 별도로 설치해야 한다)
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/bbs
